    - target: {fileID: 6339846770755584457, guid: d8a69bbc3eb4cac49b4b2810c5524577, type: 3}
      propertyPath: m_text
      value: "Der Enemy ist eine gef\xE4hrliche Entity, die dem M\xFCllroboter Schaden
        zuf\xFCgen \r\nkann, wenn sie ihn erreicht. Gegner patrouillieren entlang
        eines festgelegten Weges und bewegen sich immer dann, nachdem der Roboter
        eine Aktion fertig ausgef\xFChrt hat. Achte darauf, ihre Bewegungsmuster
        zu beobachten und deinen Roboter so zu steuern, dass er ihnen ausweicht,
        um Schaden zu vermeiden.\r\n"
      objectReference: {fileID: 0}
    - target: {fileID: 6339846770755584457, guid: d8a69bbc3eb4cac49b4b2810c5524577, type: 3}
      propertyPath: m_fontSize
      value: 17.35
      objectReference: {fileID: 0}
